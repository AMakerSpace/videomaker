/* AMaker dark – erzeugt von amaker/qt/make_qss.py, nicht von Hand ändern */
* { font-family: "Stack Sans Notch"; }
QWidget { color: #ffffff; }
QMainWindow, QDialog { background: #000000 url(":/videomaker/theme/dots-dark.svg"); }
QMainWindow::separator { background: #ffffff; width: 3px; height: 3px; }

/* Leisten */
QMenuBar { background: #000000; border-bottom: 3px solid #ffffff; font-weight: 700; padding: 2px; }
QMenuBar::item { padding: 6px 12px; background: transparent; }
QMenuBar::item:selected { background: #ffffff; color: #000000; }
QToolBar { background: #000000; border: 0; border-bottom: 3px solid #ffffff; spacing: 4px; padding: 4px; }
QToolBar::separator { background: #6b6b6b; width: 3px; margin: 4px 6px; }
QStatusBar { background: #000000; border-top: 3px solid #ffffff; font-weight: 600; }
QStatusBar::item { border: 0; }

/* Menüs & Tooltips */
QMenu { background: #000000; border: 3px solid #ffffff; border-right: 7px solid #6b6b6b; border-bottom: 7px solid #6b6b6b; padding: 2px; }
QMenu::item { padding: 7px 26px 7px 24px; font-weight: 600; }
QMenu::item:selected { background: #ffffff; color: #000000; }
QMenu::item:disabled { color: #b3b3b3; }
QMenu::separator { height: 2px; background: #ffffff; margin: 3px 0; }
QToolTip { background: #ffffff; color: #000000; border: 3px solid #ffffff; padding: 5px 8px; font-weight: 600; }

/* Knöpfe: dicke Kante rechts/unten = harter Schatten; überfahren = Verlaufsrand + 2px angehoben; Klick = eingerastet */
QPushButton { background: #9a9a9a; color: #000000; font-weight: 700; padding: 6px 16px; min-height: 22px;
  border: 3px solid qconicalgradient(cx:0.5, cy:0.5, angle:135, stop:0 #ff93a0, stop:0.33 #ffe5aa, stop:0.66 #9fddae, stop:1 #ff93a0); border-right: 7px solid #6b6b6b; border-bottom: 7px solid #6b6b6b;
  margin: 2px 0 0 2px; }
QPushButton:hover { border-top-color: qconicalgradient(cx:0.5, cy:0.5, angle:135, stop:0 #ff93a0, stop:0.33 #ffe5aa, stop:0.66 #9fddae, stop:1 #ff93a0); border-left-color: qconicalgradient(cx:0.5, cy:0.5, angle:135, stop:0 #ff93a0, stop:0.33 #ffe5aa, stop:0.66 #9fddae, stop:1 #ff93a0); margin: 0 2px 2px 0; }
QPushButton:pressed, QPushButton:checked { background: #ffffff; color: #000000; border-right-width: 3px; border-bottom-width: 3px;
  border-right-color: #ffffff; border-bottom-color: #ffffff; margin: 6px 0 0 6px; }
QPushButton:default { background: #ffffff; color: #000000; }
QPushButton:disabled { background: #2b2b2b; color: #b3b3b3; border-color: #6b6b6b; }
QToolButton { background: transparent; border: 3px solid transparent; padding: 3px; }
QToolButton:hover { background: #9a9a9a; color: #000000; border: 3px solid qconicalgradient(cx:0.5, cy:0.5, angle:135, stop:0 #ff93a0, stop:0.33 #ffe5aa, stop:0.66 #9fddae, stop:1 #ff93a0); }
/* eingerastet: grau statt schwarz, sonst verschwinden die (schwarzen) Symbole */
QToolButton:pressed, QToolButton:checked { background: #6b6b6b; border: 3px solid #ffffff; }
QToolButton::menu-indicator { image: none; }

/* Felder */
QLineEdit, QTextEdit, QPlainTextEdit, QAbstractSpinBox, QComboBox { background: #000000; color: #ffffff;
  border: 3px solid qconicalgradient(cx:0.5, cy:0.5, angle:135, stop:0 #ff93a0, stop:0.33 #ffe5aa, stop:0.66 #9fddae, stop:1 #ff93a0); padding: 4px 8px; selection-background-color: #ffffff; selection-color: #000000; }
QLineEdit:focus, QAbstractSpinBox:focus, QComboBox:focus, QTextEdit:focus { border-right: 7px solid #6b6b6b; border-bottom: 7px solid #6b6b6b; }
QComboBox::drop-down { border: 0; border-left: 3px solid #ffffff; width: 22px; background: #2b2b2b; }
QComboBox QAbstractItemView { background: #000000; border: 3px solid #ffffff; selection-background-color: #ffffff; selection-color: #000000; }
QCheckBox, QRadioButton { spacing: 8px; font-weight: 600; }
QCheckBox::indicator, QRadioButton::indicator { width: 14px; height: 14px; border: 3px solid #ffffff; background: #000000; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked { background: #ffffff; }

/* Listen & Bäume */
QAbstractItemView { background: #000000; alternate-background-color: #141414; border: 0;
  selection-background-color: #ffffff; selection-color: #000000; outline: 0; }
QAbstractItemView::item:selected { background: #ffffff; color: #000000; }
QAbstractItemView::item:hover:!selected { background: #2b2b2b; }
QHeaderView::section { background: #2b2b2b; color: #ffffff; border: 0; border-right: 2px solid #ffffff; border-bottom: 3px solid #ffffff;
  padding: 5px 8px; font-weight: 700; }

/* Reiter: Kopfzeile grau, aktiver Reiter schwarz */
QTabWidget::pane { border: 3px solid qconicalgradient(cx:0.5, cy:0.5, angle:135, stop:0 #ff93a0, stop:0.33 #ffe5aa, stop:0.66 #9fddae, stop:1 #ff93a0); background: #000000; }
QTabBar { background: #2b2b2b; font-weight: 700; }
QTabBar::tab { background: #2b2b2b; color: #ffffff; border: 0; border-right: 3px solid #ffffff; padding: 7px 14px; }
QTabBar::tab:selected { background: #ffffff; color: #000000; }
QTabBar::tab:hover:!selected { background: #000000; }

/* Schieberegler, Rollbalken, Fortschritt */
QSlider::groove:horizontal { height: 3px; background: #ffffff; }
QSlider::handle:horizontal { width: 12px; margin: -7px 0; background: #9a9a9a; border: 3px solid #ffffff; }
QSlider::handle:horizontal:hover { border-color: qconicalgradient(cx:0.5, cy:0.5, angle:135, stop:0 #ff93a0, stop:0.33 #ffe5aa, stop:0.66 #9fddae, stop:1 #ff93a0); }
QSlider::groove:vertical { width: 3px; background: #ffffff; }
QSlider::handle:vertical { height: 12px; margin: 0 -7px; background: #9a9a9a; border: 3px solid #ffffff; }
QScrollBar:vertical { background: #141414; width: 14px; border-left: 2px solid #ffffff; margin: 0; }
QScrollBar:horizontal { background: #141414; height: 14px; border-top: 2px solid #ffffff; margin: 0; }
QScrollBar::handle { background: #ffffff; min-height: 30px; min-width: 30px; margin: 2px; }
QScrollBar::handle:hover { background: #b3b3b3; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QProgressBar { background: #000000; border: 3px solid #ffffff; text-align: center; font-weight: 700; color: #ffffff; min-height: 14px; }
QProgressBar::chunk { background: qlineargradient(spread:repeat, x1:0, y1:0, x2:0.03, y2:0.12, stop:0 #ffffff, stop:0.5 #ffffff, stop:0.51 #000000, stop:1 #000000); }

/* Gruppen & Andockbereiche (Kdenlive nutzt KDDockWidgets) */
QGroupBox { border: 3px solid qconicalgradient(cx:0.5, cy:0.5, angle:135, stop:0 #ff93a0, stop:0.33 #ffe5aa, stop:0.66 #9fddae, stop:1 #ff93a0); margin-top: 14px; padding-top: 10px; font-weight: 700; background: #000000; }
QGroupBox::title { subcontrol-origin: margin; left: 8px; padding: 2px 6px; background: #ffffff; color: #000000; }
QDockWidget::title { background: #2b2b2b; border-bottom: 3px solid #ffffff; padding: 6px; font-weight: 700; }
KDDockWidgets--QtWidgets--TitleBar { background: #2b2b2b; border-bottom: 3px solid #ffffff; font-weight: 700; }
KDDockWidgets--QtWidgets--Group { border: 3px solid qconicalgradient(cx:0.5, cy:0.5, angle:135, stop:0 #ff93a0, stop:0.33 #ffe5aa, stop:0.66 #9fddae, stop:1 #ff93a0); background: #000000; }
KDDockWidgets--QtWidgets--TabBar { background: #2b2b2b; border-bottom: 3px solid #ffffff; }
KDDockWidgets--QtWidgets--Separator { background: #000000; }
KDDockWidgets--QtWidgets--MainWindow, KDDockWidgets--QtWidgets--DropArea { background: #000000 url(":/videomaker/theme/dots-dark.svg"); }

/* VideoMaker-Leisten (src/videomaker/simplemode.cpp) – andere Apps dürfen die Namen mitbenutzen */
QToolBar#videomakerTopBar { background: #000000; border: 0; border-bottom: 3px solid #ffffff; padding: 2px; }
#vmAdjustBar, #vmFilmBar { background: #2b2b2b; border-bottom: 3px solid #ffffff; }
QLabel#vmNumber { background: #ffffff; color: #000000; font-weight: 700; padding: 3px 7px; }
QLabel#vmBoxTitle { font-weight: 700; padding: 0 4px; }
#vmSeparator { background: #6b6b6b; }
QToolButton[vmButton="true"] { background: #9a9a9a; color: #000000; font-weight: 700; padding: 4px 10px;
  border: 3px solid qconicalgradient(cx:0.5, cy:0.5, angle:135, stop:0 #ff93a0, stop:0.33 #ffe5aa, stop:0.66 #9fddae, stop:1 #ff93a0); border-right: 7px solid #6b6b6b; border-bottom: 7px solid #6b6b6b; margin: 2px 0 0 2px; }
QToolButton[vmButton="true"]:hover { border-top-color: qconicalgradient(cx:0.5, cy:0.5, angle:135, stop:0 #ff93a0, stop:0.33 #ffe5aa, stop:0.66 #9fddae, stop:1 #ff93a0); border-left-color: qconicalgradient(cx:0.5, cy:0.5, angle:135, stop:0 #ff93a0, stop:0.33 #ffe5aa, stop:0.66 #9fddae, stop:1 #ff93a0); margin: 0 2px 2px 0; }
QToolButton[vmButton="true"]:checked, QToolButton[vmButton="true"]:pressed { background: #ffffff; color: #000000;
  border-right-width: 3px; border-bottom-width: 3px; border-right-color: #ffffff; border-bottom-color: #ffffff; margin: 6px 0 0 6px; }
QToolButton[vmPrimary="true"] { background: #ffffff; color: #000000; }
